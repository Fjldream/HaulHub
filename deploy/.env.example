# Server public port. Change this when packaging/deploying if the port is occupied.
HTTP_PORT=8088

# Browser-facing API path for admin-web. Keep /api when using deploy/nginx.conf.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_INTERNAL_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_BASE_PATH=

# Mobile H5 web app settings. Keep these defaults when serving through Nginx.
VITE_API_BASE_URL=/api
VITE_H5_BASE=/app/

# Amap Web Service API key. Used by the API server to search precise trip locations.
AMAP_WEB_SERVICE_KEY=

# Amap Web JS API settings. Used by admin web map picker.
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=
