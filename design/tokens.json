{
  "$schema": "https://tokens.studio/schemas/tokens.json",
  "meta": {
    "name": "HaulHub Design Tokens",
    "version": "2026-05-27",
    "source": "Stitch UI + HaulHub product design",
    "description": "Design tokens for the HaulHub lightweight transportation billing system."
  },
  "color": {
    "brand": {
      "900": "#001B3C",
      "800": "#002045",
      "700": "#1A365D",
      "600": "#2D476F",
      "100": "#D6E3FF",
      "50": "#F0F3FF"
    },
    "accent": {
      "700": "#875200",
      "500": "#F6AD55",
      "400": "#FFB55C",
      "100": "#FFDDBA",
      "50": "#FFF8EA"
    },
    "success": {
      "700": "#1F6B45",
      "600": "#2F855A",
      "100": "#DFF5E8",
      "50": "#F0FBF5"
    },
    "warning": {
      "700": "#875200",
      "600": "#B7791F",
      "100": "#FFF1D6",
      "50": "#FFF8EA"
    },
    "danger": {
      "700": "#93000A",
      "600": "#BA1A1A",
      "100": "#FFDAD6",
      "50": "#FFF5F5"
    },
    "info": {
      "700": "#2D476F",
      "600": "#455F88",
      "100": "#D6E3FF",
      "50": "#EFF6FF"
    },
    "neutral": {
      "950": "#111C2C",
      "800": "#263142",
      "700": "#43474E",
      "600": "#4A5568",
      "500": "#74777F",
      "300": "#C4C6CF",
      "200": "#E2E8F0",
      "100": "#F3F4F6",
      "50": "#F9FAFB",
      "0": "#FFFFFF"
    },
    "surface": {
      "pageAdmin": "#F6F8FA",
      "pageDriver": "#F7F9FA",
      "base": "#F9FAFB",
      "containerLow": "#F0F3FF",
      "container": "#FFFFFF",
      "containerHigh": "#E7EEFF",
      "border": "#E2E8F0",
      "borderStrong": "#C4C6CF"
    },
    "text": {
      "primary": "#111C2C",
      "secondary": "#43474E",
      "muted": "#74777F",
      "inverse": "#FFFFFF",
      "link": "#1A365D",
      "danger": "#BA1A1A",
      "success": "#2F855A"
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "\"Hanken Grotesk\", Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", Arial, sans-serif",
      "body": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", Arial, sans-serif",
      "number": "Inter, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace"
    },
    "admin": {
      "pageTitle": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 600 },
      "sectionTitle": { "fontSize": "18px", "lineHeight": "26px", "fontWeight": 600 },
      "tableBody": { "fontSize": "14px", "lineHeight": "22px", "fontWeight": 400 },
      "helper": { "fontSize": "13px", "lineHeight": "20px", "fontWeight": 400 },
      "tableSmall": { "fontSize": "12px", "lineHeight": "18px", "fontWeight": 400 }
    },
    "driver": {
      "pageTitle": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 600 },
      "cardTitle": { "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600 },
      "body": { "fontSize": "15px", "lineHeight": "23px", "fontWeight": 400 },
      "label": { "fontSize": "14px", "lineHeight": "22px", "fontWeight": 500 },
      "helper": { "fontSize": "13px", "lineHeight": "20px", "fontWeight": 400 }
    },
    "number": {
      "fontVariantNumeric": "tabular-nums",
      "currencyDecimalPlaces": 2
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "mobileMargin": "16px",
    "desktopMargin": "40px",
    "desktopGutter": "24px"
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "full": "9999px"
  },
  "shadow": {
    "card": "0 1px 2px rgba(26, 54, 93, 0.06)",
    "popover": "0 8px 20px rgba(26, 54, 93, 0.10)",
    "modal": "0 12px 32px rgba(26, 54, 93, 0.16)",
    "mobileActionBar": "0 -8px 24px rgba(26, 54, 93, 0.10)"
  },
  "component": {
    "button": {
      "heightAdmin": "36px",
      "heightDriver": "44px",
      "radius": "4px",
      "primaryBg": "{color.brand.700}",
      "primaryFg": "{color.text.inverse}",
      "accentBg": "{color.accent.500}",
      "accentFg": "{color.brand.900}",
      "dangerBg": "{color.danger.600}",
      "dangerFg": "{color.text.inverse}"
    },
    "input": {
      "heightAdmin": "36px",
      "heightDriver": "44px",
      "radius": "4px",
      "background": "{color.neutral.0}",
      "border": "{color.surface.borderStrong}",
      "focusBorder": "{color.brand.700}",
      "errorBorder": "{color.danger.600}"
    },
    "card": {
      "radius": "8px",
      "padding": "16px",
      "background": "{color.neutral.0}",
      "border": "{color.surface.border}",
      "shadow": "{shadow.card}"
    },
    "table": {
      "rowHeight": "48px",
      "headerBg": "{color.neutral.50}",
      "hoverBg": "{color.surface.pageAdmin}",
      "border": "{color.surface.border}"
    },
    "mobile": {
      "touchTargetMin": "44px",
      "touchTargetPreferred": "48px",
      "bottomActionSafePadding": "16px"
    }
  },
  "status": {
    "assigned": {
      "label": "待出车",
      "fg": "{color.neutral.700}",
      "bg": "{color.neutral.100}",
      "border": "{color.neutral.200}"
    },
    "inProgress": {
      "label": "进行中",
      "fg": "{color.info.700}",
      "bg": "{color.info.50}",
      "border": "{color.info.100}"
    },
    "submitted": {
      "label": "已提交",
      "fg": "{color.warning.700}",
      "bg": "{color.warning.50}",
      "border": "{color.warning.100}"
    },
    "underReview": {
      "label": "审核中",
      "fg": "{color.warning.700}",
      "bg": "{color.warning.50}",
      "border": "{color.warning.100}"
    },
    "completed": {
      "label": "已完成",
      "fg": "{color.success.700}",
      "bg": "{color.success.50}",
      "border": "{color.success.100}"
    },
    "returned": {
      "label": "已退回",
      "fg": "{color.danger.700}",
      "bg": "{color.danger.50}",
      "border": "{color.danger.100}"
    }
  },
  "finance": {
    "currency": "CNY",
    "currencySymbol": "¥",
    "decimalPlaces": 2,
    "useTabularNumbers": true,
    "positiveProfitFg": "{color.success.600}",
    "negativeProfitFg": "{color.danger.600}",
    "zeroProfitFg": "{color.text.secondary}",
    "driverHiddenFields": [
      "estimatedFreight",
      "actualFreight",
      "profit",
      "profitRate",
      "businessReports"
    ]
  }
}
