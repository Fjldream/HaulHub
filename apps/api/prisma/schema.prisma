generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  teamId       String?
  name         String
  phone        String     @unique
  passwordHash String
  role         String
  status       String   @default("active")
  isFirstLogin Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  team           Team?                  @relation(fields: [teamId], references: [id])
  driverBindings DriverVehicleBinding[] @relation("DriverBindings")
  createdTrips    Trip[]                 @relation("CreatedTrips")
  drivenTrips     Trip[]                 @relation("DriverTrips")
  expenses        Expense[]              @relation("ExpenseCreator")
  settlements     SettlementSnapshot[]   @relation("SettlementUser")
  auditLogs       AuditLog[]             @relation("AuditActor")
  maintenanceRecords VehicleMaintenance[] @relation("MaintenanceCreator")
  driverDocuments DriverDocument[]       @relation("DriverDocuments")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("active")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  vehicles           Vehicle[]
  driverBindings     DriverVehicleBinding[]
  expenseTypes       ExpenseType[]
  trips              Trip[]
  maintenanceRecords VehicleMaintenance[]
  auditLogs          AuditLog[]
}

model Vehicle {
  id                 String        @id @default(cuid())
  teamId             String
  plateNumber        String        @unique
  status             String        @default("available")
  vehicleType        String?
  brandModel         String?
  loadCapacityTons   Decimal?
  registeredAt       DateTime?
  insuranceExpiresAt DateTime?
  inspectionExpiresAt DateTime?
  maintenanceDueAt   DateTime?
  imageUrl           String?
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  team           Team                   @relation(fields: [teamId], references: [id])
  driverBindings DriverVehicleBinding[]
  trips          Trip[]
  maintenanceRecords VehicleMaintenance[]
}

model DriverVehicleBinding {
  id        String   @id @default(cuid())
  teamId    String
  vehicleId String
  driverId  String
  createdAt DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  User    @relation("DriverBindings", fields: [driverId], references: [id])

  @@unique([vehicleId, driverId])
}

model ExpenseType {
  id              String   @id @default(cuid())
  teamId          String
  name            String
  requiresReceipt Boolean  @default(false)
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team     Team      @relation(fields: [teamId], references: [id])
  expenses Expense[]

  @@unique([teamId, name])
}

model Trip {
  id               String     @id @default(cuid())
  teamId           String
  tripNo           String     @unique
  vehicleId        String
  driverId         String
  customerName     String
  loadLocation     String
  loadAddress      String?
  loadLatitude     Float?
  loadLongitude    Float?
  loadPoiId        String?
  unloadLocation   String
  unloadAddress    String?
  unloadLatitude   Float?
  unloadLongitude  Float?
  unloadPoiId      String?
  locationProvider String?
  estimatedFreight Decimal?
  actualFreight    Decimal?
  status           String   @default("assigned")
  driverNote       String?
  accountingNote   String?
  returnReason     String?
  createdBy        String
  startedAt        DateTime?
  submittedAt      DateTime?
  reviewStartedAt  DateTime?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  team       Team               @relation(fields: [teamId], references: [id])
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id])
  driver     User                @relation("DriverTrips", fields: [driverId], references: [id])
  creator    User                @relation("CreatedTrips", fields: [createdBy], references: [id])
  expenses   Expense[]
  settlement SettlementSnapshot?
}

model Expense {
  id                      String   @id @default(cuid())
  tripId                  String
  expenseTypeId           String
  expenseTypeNameSnapshot String
  amount                  Decimal
  occurredAt              DateTime
  note                    String?
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  trip          Trip           @relation(fields: [tripId], references: [id])
  expenseType   ExpenseType    @relation(fields: [expenseTypeId], references: [id])
  creator       User           @relation("ExpenseCreator", fields: [createdBy], references: [id])
  receiptImages ReceiptImage[]
}

model ReceiptImage {
  id         String   @id @default(cuid())
  expenseId  String
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id])
}

model SettlementSnapshot {
  id            String   @id @default(cuid())
  tripId        String   @unique
  actualFreight Decimal
  expenseTotal  Decimal
  profit        Decimal
  profitRate    Decimal?
  settledBy     String
  settledAt     DateTime @default(now())

  trip    Trip @relation(fields: [tripId], references: [id])
  settler User @relation("SettlementUser", fields: [settledBy], references: [id])
}

model VehicleMaintenance {
  id                String   @id @default(cuid())
  teamId            String
  vehicleId         String
  component         String
  amount            Decimal
  occurredAt        DateTime
  voucherStorageKey String?
  note              String?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team    Team    @relation(fields: [teamId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  creator User    @relation("MaintenanceCreator", fields: [createdBy], references: [id])
}

model DriverDocument {
  id         String   @id @default(cuid())
  driverId   String
  type       String
  name       String
  status     String   @default("missing")
  storageKey String?
  expiresAt  DateTime?
  note       String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  driver User @relation("DriverDocuments", fields: [driverId], references: [id])

  @@unique([driverId, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  teamId     String?
  actorId    String
  targetType String
  targetId   String
  action     String
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  team  Team? @relation(fields: [teamId], references: [id])
  actor User @relation("AuditActor", fields: [actorId], references: [id])
}
